# --------------------------------------------------------------------------
# DBot_admin – Konfigurationsvorlage
# --------------------------------------------------------------------------
# Kopiere diese Datei nach `.env` und trage deine echten Werte ein:
#   cp .env.example .env
# Wichtig: `.env` NIE in Git einchecken (siehe .gitignore).
# --------------------------------------------------------------------------

# Discord-Bot-Token (aus dem Discord-Entwicklerportal -> Bot -> Reset Token)
DISCORD_TOKEN=DEIN_BOT_TOKEN_HIER_EINFUEGEN

# Optionale Konfiguration
# ----------------------------
# Ollama-Endpoint (Standard: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# Standardmodell, das beim Start verwendet wird
DEFAULT_MODEL=qwen2.5-coder:14b

# Wie viele letzte Nachrichten pro Kanal als Kontext verwendet werden
CONTEXT_LENGTH=10

# Kommagetrennte Channel-IDs, auf die der Bot reagieren soll.
# Leer lassen = alle Kanäle, auf die der Bot Zugriff hat.
# Beispiel: 123456789012345678,987654321098765432
ALLOWED_CHANNEL_IDS=

# Timeout in Sekunden für Ollama-Antworten
RESPONSE_TIMEOUT=120
